# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

use_modular_headers!

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Fix for super_native_extensions: the ObjC static library target and
    # the Rust build script both produce libsuper_native_extensions.a at the
    # same path, causing "Multiple commands produce".
    # Additionally, Xcode's new build system pre-creates
    # libsuper_native_extensions.a as a SYMLINK into UninstalledProducts —
    # cargo would write through it and mv would rename the link away, leaving
    # -lsuper_native_extensions with nothing to find.
    # Workaround:
    #   1. Remove the product symlink (if any) so cargo writes a real file
    #   2. Build the Rust library, rename it to librust_super_native_extensions.a
    #   3. Recreate the product symlink so the Runner link finds the ObjC archive
    if target.name == 'super_native_extensions'
      target.shell_script_build_phases.each do |phase|
        if phase.name&.include?('Build SuperNativeExtensions')
          # Declare the renamed Rust library as the script output so Xcode
          # doesn't treat libsuper_native_extensions.a as produced twice.
          phase.output_paths = ["${CONFIGURATION_BUILD_DIR}/librust_super_native_extensions.a"]

          phase.shell_script = %q{
objc_lib="${CONFIGURATION_BUILD_DIR}/libsuper_native_extensions.a"
rust_lib="${CONFIGURATION_BUILD_DIR}/librust_super_native_extensions.a"

# Xcode 新构建系统会预先把 libsuper_native_extensions.a 建成指向
# UninstalledProducts 的符号链接(见构建日志的 SymLink 步骤)。
# cargo 直接写会"穿透"符号链接,而 mv 又会把这个链接挪走,导致
# Runner 链接时 -lsuper_native_extensions 找不到。先删掉它,
# 让 cargo 产出真实文件。
if [ -L "$objc_lib" ]; then
  rm "$objc_lib"
  echo "Removed product symlink before Rust build"
fi

# Build the Rust library; by default it writes libsuper_native_extensions.a
sh "$PODS_TARGET_SRCROOT/../cargokit/build_pod.sh" ../rust super_native_extensions

# Move Rust output to a unique name so it doesn't collide with the ObjC
# static library that libtool will create later.
if [ -f "$objc_lib" ] && [ ! -L "$objc_lib" ]; then
  mv "$objc_lib" "$rust_lib"
  echo "Rust library renamed to librust_super_native_extensions.a"
else
  echo "WARNING: Rust library not found at expected path"
fi

# 恢复构建系统期望的产品符号链接,指向稍后 Libtool 产出的 ObjC 静态库,
# 保证 Runner 的 -lsuper_native_extensions 在链接时能找到。
ln -sfh ../../../IntermediateBuildFilesPath/UninstalledProducts/iphoneos/libsuper_native_extensions.a "$objc_lib"
echo "Recreated product symlink for ObjC static library"
}
        end
      end
    end

    target.build_configurations.each do |config|
      # You can remove unused permissions here
      # for more infomation: https://github.com/BaseflowIT/flutter-permission-handler/blob/master/permission_handler/ios/Classes/PermissionHandlerEnums.h
      # e.g. when you don't need camera permission, just add 'PERMISSION_CAMERA=0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',

        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',

        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',

        ## dart: [PermissionGroup.location, PermissionGroup.locationAlways, PermissionGroup.locationWhenInUse]
        'PERMISSION_LOCATION=1',

        ## dart: PermissionGroup.notification
        'PERMISSION_NOTIFICATIONS=1',

        ## dart: PermissionGroup.mediaLibrary
        'PERMISSION_MEDIA_LIBRARY=1',
      ]
    end
  end

  # Add -force_load for the Rust-built super_native_extensions library
  # to the EXISTING OTHER_LDFLAGS line (do NOT overwrite it)
  xcconfig_dir = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner')
  ['debug', 'release', 'profile'].each do |config|
    path = File.join(xcconfig_dir, "Pods-Runner.#{config}.xcconfig")
    next unless File.exist?(path)
    content = File.read(path)
    unless content.include?('librust_super_native_extensions')
      # Append to the existing OTHER_LDFLAGS line, not overwrite it
      content.sub!(/^(OTHER_LDFLAGS = .*)/,
                   '\1 -force_load ${PODS_CONFIGURATION_BUILD_DIR}/super_native_extensions/librust_super_native_extensions.a')
      File.write(path, content)
    end
  end
end
