# Uncomment this line to define a global platform for your project
platform :ios, '15.5'

use_modular_headers!

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Fix for super_native_extensions: the ObjC static library target and
    # the Rust build script both produce libsuper_native_extensions.a at the
    # same path, causing "Multiple commands produce".
    # Additionally, cargokit_phony (symlinked to build.db) can cause this
    # script to execute more than once per build; on re-runs we must not
    # move away the ObjC static library that lipo has already produced.
    # Workaround:
    #   1. Save any existing libsuper_native_extensions.a (the ObjC archive)
    #   2. Build the Rust library (produces libsuper_native_extensions.a)
    #   3. Move Rust output to a unique file (librust_super_native_extensions.a)
    #   4. Restore the saved ObjC archive so linking can find it
    if target.name == 'super_native_extensions'
      target.shell_script_build_phases.each do |phase|
        if phase.name&.include?('Build SuperNativeExtensions')
          # Declare the renamed Rust library as the script output so Xcode
          # doesn't treat libsuper_native_extensions.a as produced twice.
          phase.output_paths = ["${CONFIGURATION_BUILD_DIR}/librust_super_native_extensions.a"]

          phase.shell_script = %q{
objc_lib="${CONFIGURATION_BUILD_DIR}/libsuper_native_extensions.a"
objc_stash="${CONFIGURATION_BUILD_DIR}/libsuper_native_extensions_objc.a"
rust_lib="${CONFIGURATION_BUILD_DIR}/librust_super_native_extensions.a"

# If a previous run was interrupted and left a stale stash, restore it first.
if [ -f "$objc_stash" ]; then
  mv "$objc_stash" "$objc_lib"
  echo "Restored stale ObjC static library stash"
fi

# If the ObjC static library already exists (e.g. from a previous lipo step
# or a cached build), stash it so the Rust build below doesn't overwrite it
# and the mv below doesn't move it away.
if [ -f "$objc_lib" ]; then
  mv "$objc_lib" "$objc_stash"
  echo "Saved existing ObjC static library"
fi

# Build the Rust library; by default it writes libsuper_native_extensions.a
sh "$PODS_TARGET_SRCROOT/../cargokit/build_pod.sh" ../rust super_native_extensions

# Move Rust output to a unique name so it doesn't collide with the ObjC
# static library that lipo will create later.
if [ -f "$objc_lib" ]; then
  mv "$objc_lib" "$rust_lib"
  echo "Rust library renamed to librust_super_native_extensions.a"
else
  echo "WARNING: Rust library not found at expected path"
fi

# Restore the ObjC static library if we stashed one earlier.
if [ -f "$objc_stash" ]; then
  mv "$objc_stash" "$objc_lib"
  echo "Restored ObjC static library"
fi
}
        end
      end
    end

    target.build_configurations.each do |config|
      # You can remove unused permissions here
      # for more infomation: https://github.com/BaseflowIT/flutter-permission-handler/blob/master/permission_handler/ios/Classes/PermissionHandlerEnums.h
      # e.g. when you don't need camera permission, just add 'PERMISSION_CAMERA=0'
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',

        ## dart: PermissionGroup.camera
        'PERMISSION_CAMERA=1',

        ## dart: PermissionGroup.microphone
        'PERMISSION_MICROPHONE=1',

        ## dart: PermissionGroup.photos
        'PERMISSION_PHOTOS=1',

        ## dart: [PermissionGroup.location, PermissionGroup.locationAlways, PermissionGroup.locationWhenInUse]
        'PERMISSION_LOCATION=1',

        ## dart: PermissionGroup.notification
        'PERMISSION_NOTIFICATIONS=1',

        ## dart: PermissionGroup.mediaLibrary
        'PERMISSION_MEDIA_LIBRARY=1',
      ]
    end
  end

  # Add -force_load for the Rust-built super_native_extensions library
  # to the EXISTING OTHER_LDFLAGS line (do NOT overwrite it)
  xcconfig_dir = File.join(installer.sandbox.root, 'Target Support Files', 'Pods-Runner')
  ['debug', 'release', 'profile'].each do |config|
    path = File.join(xcconfig_dir, "Pods-Runner.#{config}.xcconfig")
    next unless File.exist?(path)
    content = File.read(path)
    unless content.include?('librust_super_native_extensions')
      # Append to the existing OTHER_LDFLAGS line, not overwrite it
      content.sub!(/^(OTHER_LDFLAGS = .*)/,
                   '\1 -force_load ${PODS_CONFIGURATION_BUILD_DIR}/super_native_extensions/librust_super_native_extensions.a')
      File.write(path, content)
    end
  end
end
